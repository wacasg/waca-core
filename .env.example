# WACA core local configuration example
# Copy this file to .env and replace every placeholder with your own values.
# Do not commit .env.

# Google Cloud / BigQuery
BQ_PROJECT=your-gcp-project-id
BQ_LOCATION=asia-northeast1
BQ_DATASET=waca_core_output
GA4_BQ_PROJECT=your-gcp-project-id
GA4_BQ_DATASET=analytics_123456789
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-or-adc.json

# Optional anonymous sample dataset for install tests
SAMPLE_GA4_DATASET=waca_core_sample_ga4

# Daily batch wrapper
PROJECT_ID=your-gcp-project-id
TARGET_DATASET=waca_core_output
SOURCE_DATASET=analytics_123456789
PROCEDURE_NAME=run_waca_core_batch
CLIENT_ID=example-client
BATCH_TIMEZONE=Asia/Tokyo
INITIAL_START_DATE=20260101
INITIAL_END_DATE=auto
RESET_REBUILD_START_DATE=20260101
ENABLE_SCHEMA_CHANGE_RESET=false
BQ_JOB_TIMEOUT_SECONDS=1700
LOG_LEVEL=INFO
